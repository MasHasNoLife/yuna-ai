# Copy to .env and fill in. Never commit the real .env file.

# ── Discord bot ──────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token-here

# Your own Discord user ID (right-click your name -> Copy User ID).
# Messages from this ID write to the authoritative "global" memory partition.
MAS_DISCORD_ID=000000000000000000

# ── Dashboard (optional) ─────────────────────────────────────────────────────
# If set, the dashboard API requires "Authorization: Bearer <token>".
# Leave unset for localhost-only use.
# YUNA_DASHBOARD_TOKEN=change-me
