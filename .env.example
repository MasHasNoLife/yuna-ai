# Discord bot credentials — copy to .env and fill in.
# Never commit the real .env file.

# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token-here

# Your own Discord user ID (right-click your name -> Copy User ID).
# Messages from this ID write to the authoritative "global" memory partition.
MAS_DISCORD_ID=000000000000000000
